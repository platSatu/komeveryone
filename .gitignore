# File buatan aplikasi per user (QR & sertifikat): tidak ikut git, isinya dibawa dari server.
# Template sertifikat tetap ikut git.
/public/kmdqr/*
!/public/kmdqr/.gitkeep
/public/kmdsertifikat/*
!/public/kmdsertifikat/sertifikat.jpg

# Foto profil yang di-upload user: tidak ikut git (foto lama yang sudah terlanjur tercatat dibiarkan,
# supaya git pull di server tidak menghapus foto apa pun).
/public/kom/profile/*
